# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Both values below are browser-safe: the publishable key is designed to be
# shipped to clients. All real access control is enforced by row-level security
# in Postgres. Never put a service-role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# The single account allowed to use private mode. Must match the RLS policy in
# supabase/migrations/*_budget_forecast_owner_sync.sql.
EXPO_PUBLIC_OWNER_EMAIL=you@example.com
